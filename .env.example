DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-me-for-local-production-testing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset to use local SQLite. Render supplies this automatically.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: enables live Shiprocket serviceability and delivery estimates at checkout.
# Use either an API token or an email/password pair. Keep actual credentials out of Git.
# SHIPROCKET_API_TOKEN=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=

# ZeptoMail HTTPS Send API (set these privately in Render, never commit a key).
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_KEY=your-send-api-key
# PUBLIC_SITE_URL=https://harvisdelights.com
# DEFAULT_FROM_EMAIL=hdcare@harvisdelights.com
# SELLER_NOTIFICATION_EMAIL=hdcare@harvisdelights.com
# Live payments require an explicit opt-in and matching live credentials.
RAZORPAY_MODE=test
RAZORPAY_LIVE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
